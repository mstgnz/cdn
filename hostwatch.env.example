# Settings for the hostwatch container. Copy to hostwatch.env, which is ignored
# by git and by the image build. Only hostwatch reads it; the API replicas read
# .env. Enable the container with COMPOSE_PROFILES=hostwatch in .env.
# See docs/deployment.md, "Host monitoring".

# Required. Port 587 uses STARTTLS, 465 implicit TLS; there is no plaintext mode.
HOSTWATCH_SMTP_HOST=
HOSTWATCH_SMTP_PORT=587
HOSTWATCH_SMTP_USERNAME=
HOSTWATCH_SMTP_PASSWORD=
HOSTWATCH_SMTP_FROM=CDN Alerts <alerts@example.com>
HOSTWATCH_SMTP_TO=ops@example.com

# Optional push URL of an external watcher (Uptime Kuma push monitor), called
# every interval so that hostwatch dying is noticed from outside the host.
HOSTWATCH_HEARTBEAT_URL=

# Everything below has a working default. HOSTNAME defaults to the host's
# /etc/hostname. MEMORY_FOR is how long memory must stay high before it alerts,
# since image bursts spike it briefly. HYSTERESIS is how many points below a
# threshold a value must fall before the alert counts as cleared.
#HOSTWATCH_HOSTNAME=
#HOSTWATCH_INTERVAL=1m
#HOSTWATCH_DISK_WARN=80
#HOSTWATCH_DISK_CRIT=90
#HOSTWATCH_INODE_WARN=80
#HOSTWATCH_INODE_CRIT=90
#HOSTWATCH_MEMORY_WARN=80
#HOSTWATCH_MEMORY_CRIT=90
#HOSTWATCH_MEMORY_FOR=5m
#HOSTWATCH_HYSTERESIS=3
#HOSTWATCH_REMIND_EVERY=6h
#HOSTWATCH_EXCLUDE_FSTYPES=squashfs,iso9660
#HOSTWATCH_EXCLUDE_MOUNTS=
