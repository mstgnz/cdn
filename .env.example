# App Configuration
APP_NAME=cdn
APP_PORT=9090
APP_URL=https://cdn.example.com

# Must be at least 32 characters and not a placeholder, or the service refuses to
# boot. Generate one with: openssl rand -hex 32
TOKEN=REPLACE_ME

# Optional bucket-scoped tokens (see config/tokens.template.json). Each entry
# authorizes writes to a single bucket via "Authorization: Bearer <bucket>:<token>".
# When the file is absent, TOKEN above is the only accepted credential.
# The file is read once at boot; restart the service after editing it.
TOKENS_FILE=config/tokens.json

# MinIO Configuration
#
# Pin the server image on any deployment holding real data. Blank means latest,
# which is fine for a fresh install and not fine for an existing one: MinIO
# upgrades forward across the on-disk format but never backward, so an
# accidental jump is not something you undo by changing the tag back.
#
#   MINIO_VERSION=RELEASE.2022-10-24T18-35-07Z
MINIO_VERSION=
MINIO_ENDPOINT=cdn-minio:9000
MINIO_ROOT_USER=your-minio-user
MINIO_ROOT_PASSWORD=your-minio-password
# Set true when MinIO is served over TLS
MINIO_USE_SSL=false

# Version of the mc client container (docker compose --profile tools up -d mc).
# Pin this if you run an older MinIO server: newer mc is fine for ls/du/cp, but
# mc admin commands are sensitive to the server version.
MC_VERSION=latest

# Redis Configuration
REDIS_URL=redis://cdn-redis:6379

# AWS Configuration
#
# Leave these blank to run on MinIO alone. The archive below switches itself off
# when they are empty, silently and by design: a deployment without AWS is a
# supported deployment, not a misconfigured one.
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
AWS_BUCKET=

# Cold-storage archive
#
# When AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_REGION are all set, every
# upload is mirrored to S3 in the Glacier Instant Retrieval class, and objects
# MinIO no longer has are served from there. Instant Retrieval is what makes that
# possible: it answers a normal GET in milliseconds, where the older Glacier
# classes need a restore request and minutes to hours of waiting.
#
# Set false to keep AWS credentials configured for other purposes without
# archiving to them.
ARCHIVE_ENABLED=true
# Blank means one S3 bucket per MinIO bucket, sharing its name and keys. Setting
# a name puts everything in that one bucket under a "<minio-bucket>/" prefix.
#
# Setting it is RECOMMENDED. S3 bucket names are unique across every AWS account
# on earth, while MinIO's only have to be unique locally, so ordinary names like
# "media" or "uploads" cannot be recreated in S3 and bucket parity fails for them
# partway through a backfill. A single bucket also means a new MinIO bucket needs
# no AWS work: with parity, uploads auto-create the MinIO bucket but not the S3
# one, and that bucket then quietly never gets archived.
#
# Bucket parity is the better fit when you have a few distinctively-named buckets
# and want per-bucket IAM or replication rules in AWS.
#
# Choose before the first backfill and do not change it afterwards: the mapping is
# resolved fresh on every request, so switching strands everything already
# archived at keys nothing will look for again. See docs/archive.md.
ARCHIVE_BUCKET=

# Which local buckets are archived. Blank means all of them, which is the
# default because a deployment that turns the archive on usually wants its data
# covered, and an opt-in list would leave new buckets silently unprotected until
# somebody remembered to add them.
#
# Comma-separated to narrow it: ARCHIVE_ONLY_BUCKETS=photos,documents
#
# Note the name is not ARCHIVE_BUCKETS. That would be one letter from
# ARCHIVE_BUCKET above, which sets the destination, and a typo between the two
# would configure something entirely different without looking wrong.
#
# This gates writing, never reading. An object already archived is still served
# from the archive even if its bucket is later removed from this list, so
# narrowing the scope cannot break URLs. It does mean anything not yet archived
# in a removed bucket stays local forever, and retention will skip that bucket
# entirely rather than warn about every object in it.
ARCHIVE_ONLY_BUCKETS=

# Retention: free local disk by deleting objects the archive already holds.
#
# Off by default, and reporting-only the first time it is switched on, because
# the one thing this job does is delete files. An object is removed from MinIO
# only after the archive has confirmed a copy of the same size; anything
# unverified is kept and logged. Nothing is ever deleted from the archive.
#
# Before enabling on an existing deployment, check that older objects really were
# archived: uploads made before this feature existed have no copy, and the job
# will (correctly) refuse to delete them.
RETENTION_ENABLED=false
RETENTION_DRY_RUN=true
RETENTION_DAYS=365
RETENTION_INTERVAL_HOURS=24
# Blank means every bucket; comma-separated to limit the sweep.
RETENTION_BUCKETS=

RATE_LIMIT=100
UPLOAD_RATE_LIMIT=50
RATE_LIMIT_DURATION=1

# File Validation
VALIDATE_FILE=true
MAX_FILE_SIZE=104857600

# Feature Flags
DISABLE_DELETE=false
DISABLE_UPLOAD=false
DISABLE_GET=false

# Worker Configuration
WORKER_POOL_SIZE=5
WORKER_QUEUE_SIZE=10
WORKER_MAX_RETRIES=3
WORKER_RETRY_DELAY_MS=1000
WORKER_BATCH_SIZE=10
WORKER_FLUSH_TIMEOUT_MS=5000
WORKER_MAX_CONCURRENT=5

# ImageMagick Resource Limits (protect against decompression bombs / oversized resizes)
IMAGICK_MEMORY_LIMIT_MB=512
IMAGICK_MAP_LIMIT_MB=1024
IMAGICK_AREA_LIMIT_MP=256
IMAGICK_DISK_LIMIT_MB=2048
IMAGICK_TIME_LIMIT_SEC=60
IMAGICK_WIDTH_LIMIT=16384
IMAGICK_HEIGHT_LIMIT=16384
# The single most important number here for memory. ImageMagick otherwise starts
# one OpenMP thread per core, and because its buffers come from malloc rather
# than the Go heap, glibc keeps a per-thread arena that it never returns to the
# OS: RSS only climbs. Three replicas on an 8-core host sat at 2.5-2.9 GB each
# and were repeatedly OOM-killed; at 2 threads the same workload holds ~200 MB.
# Raise it only alongside MALLOC_ARENA_MAX in the dockerfile.
IMAGICK_THREAD_LIMIT=2
# Maximum width/height accepted for on-the-fly resize (larger requests are clamped)
MAX_RESIZE_DIMENSION=4096

# Concurrent decodes on the read path. OPTIMIZE_MAX_CONCURRENT covers uploads
# only, which left GET unbounded: one gallery page could start twenty full
# decodes at once. A request that finds every slot busy waits, and only if the
# wait runs out is the original served unresized (marked no-store so no cache
# keeps it under the resized URL).
RESIZE_MAX_CONCURRENT=4
RESIZE_QUEUE_TIMEOUT_SEC=10

# Go runtime. GOMEMLIMIT is a soft ceiling that makes the collector work harder
# as it is approached; it bounds the Go heap only, not ImageMagick's C
# allocations, so keep it comfortably under the container's memory limit.
GOMEMLIMIT=1200MiB
GOGC=50

# Upload Optimization (opt-in via optimize=true on upload; defaults are visually lossless)
OPTIMIZE_MAX_DIMENSION=2560
OPTIMIZE_JPEG_QUALITY=85
OPTIMIZE_WEBP_QUALITY=85
OPTIMIZE_PNG_QUALITY=95
OPTIMIZE_MAX_CONCURRENT=4

# SSRF guard for /upload-url: set true only for self-hosted setups that fetch from internal hosts
UPLOAD_URL_ALLOW_PRIVATE=false

# Request hardening
MAX_BATCH_FILES=100
READ_BUFFER_SIZE_KB=1024
